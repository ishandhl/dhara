# ── Database (Neon) ─────────────────────────────────────────────
# App traffic: the POOLED connection string (host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
# Migrations and backups: the DIRECT connection string (same, without "-pooler").
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
# For local development both can point to the same local database:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dairy?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/dairy?schema=public"

# ── Login sessions ──────────────────────────────────────────────
# Long random string (48+ characters). Required in production; changing it logs everyone out.
AUTH_SECRET="change-me"

# ── First setup only (npm run db:seed -- --production) ──────────
# Password for the "admin" user created on an empty database. At least 10 characters.
# ADMIN_PASSWORD=""
